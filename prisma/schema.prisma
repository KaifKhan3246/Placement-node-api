generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Roles supported by PlacePrep Secure
enum UserRole {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  TEACHER
  STUDENT
}

// Institution / College
model Tenant {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(150)
  slug     String  @unique @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  users User[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenants")
}

// Platform Users
model User {
  id String @id @default(uuid()) @db.Uuid

  // Microsoft Entra ID identity
  entraTenantId String @map("entra_tenant_id") @db.VarChar(64)
  entraObjectId String @map("entra_object_id") @db.VarChar(64)

  email    String @db.VarChar(320)
  fullName String @map("full_name") @db.VarChar(150)

  role     UserRole @default(STUDENT)
  isActive Boolean  @default(true) @map("is_active")

  // Institution association
  tenantId String? @map("tenant_id") @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // A Microsoft identity must not be registered twice
  @@unique([entraTenantId, entraObjectId])
  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@map("users")
}
